generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OfficialTeam {
  id                Int      @id @default(autoincrement())
  teamName          String
  callsign          String
  mainCid           Int
  aircraftType      String
  country           String
  sinceYear         Int?
  multiSlot         Boolean  @default(false)
  rosterEnabled     Boolean  @default(false)
  description       String?
  website           String?
  sortOrder         Int      @default(0)
  participatingWf26 Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model Affiliate {
  id                Int      @id @default(autoincrement())
  name              String?
  callsign          String
  simType           String
  cid               Int
  sinceYear         Int?
  hasMembers        Boolean  @default(false)
  multiAircraft     Boolean  @default(false)
  maskName          Boolean  @default(false)
  fleetLimit        Int?
  manualCallsigns   Boolean  @default(false)
  rosterEnabled     Boolean  @default(false)
  aircraftType      String?
  description       String?
  website           String?
  sortOrder         Int      @default(0)
  participatingWf26 Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model AffiliateMember {
  id          Int      @id @default(autoincrement())
  affiliateId Int
  cid         Int
  active      Boolean  @default(true)
  /// Manages this affiliate as if they were its main CID: edit bookings,
  /// claim sectors, manage members. Per-affiliate on purpose - someone can
  /// manage one affiliate and be an ordinary member of another.
  manager     Boolean  @default(false)
  addedAt     DateTime @default(now())

  @@unique([affiliateId, cid])
  @@index([affiliateId])
  @@index([cid])
}

model AffiliateSectorClaim {
  id           Int      @id @default(autoincrement())
  affiliateId  Int
  sectorNumber String
  cid          Int
  callsign     String?
  claimedAt    DateTime @default(now())

  @@unique([affiliateId, sectorNumber, callsign])
  @@index([affiliateId])
  @@index([cid])
}

model DepFlow {
  id        Int      @id @default(autoincrement())
  eventId   Int
  sector    String
  rate      Int
  flowtype  String   @default("NONE")
  updatedAt DateTime @updatedAt

  @@unique([eventId, sector])
  @@index([eventId])
}

model TobtBooking {
  id            Int      @id @default(autoincrement())
  slotKey       String
  cid           Int
  callsign      String
  from          String
  to            String
  dateUtc       String
  depTimeUtc    String
  tobtTimeUtc   String?
  assignedRoute String   @default("A")  // 'A' = primary route, 'B' = secondary route
  manual        Boolean  @default(false)
  /// Placeholder place held by auto-assignment for a manual-callsign
  /// affiliate, before the operator has named the aircraft flying it.
  /// Shown as [Reserved] rather than the base callsign, and released back
  /// to the public if still unclaimed 12h before departure.
  reserved      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([cid, slotKey])
}

model User {
  cid   Int     @id
  name  String
  // Captured at VATSIM login — the only moment we are given it. Nullable: a
  // user may decline the email scope, and existing rows predate this.
  email String?
}

model Airport {
  icao    String   @id
  name    String?
  iata    String?
  lat     Float
  lon     Float
  elev    Int?
  runways Runway[]
}

model Runway {
  id          Int     @id @default(autoincrement())
  airportIcao String
  ident1      String?
  ident2      String?
  lat1        Float
  lon1        Float
  lat2        Float
  lon2        Float
  airport     Airport @relation(fields: [airportIcao], references: [icao], onDelete: Cascade)
}

model AirportScenery {
  id          Int      @id @default(autoincrement())
  icao        String
  sim         String
  name        String
  developer   String?
  store       String?
  url         String
  type        String
  submittedBy String
  submittedAt DateTime @default(now())
  approved    Boolean  @default(false)
  approvedBy  String?
  approvedAt  DateTime?

  reports     SceneryReport[]

  @@index([icao])
  @@index([approved])
}

model SceneryReport {
  id          Int      @id @default(autoincrement())
  sceneryId   Int
  reason      String
  details     String?
  reportedBy  String
  reportedAt  DateTime @default(now())
  resolved    Boolean  @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?

  scenery     AirportScenery @relation(fields: [sceneryId], references: [id], onDelete: Cascade)

  @@index([sceneryId])
  @@index([resolved])
}

model DocumentationPermission {
  id        Int      @id @default(autoincrement())
  cid       Int
  pattern   String
  createdAt DateTime @default(now())

  @@index([cid])
}

model AirportDocument {
  id         Int      @id @default(autoincrement())
  icao       String
  filename   String
  uploadedBy Int
  uploadedAt DateTime @default(now())
  eventId    Int?

  @@unique([icao, filename])
  @@index([icao])
  @@index([eventId])
}

model DocumentationAccessRequest {
  id          Int       @id @default(autoincrement())
  cid         Int
  pattern     String
  name        String?
  email       String?
  role        String?
  requestedAt DateTime  @default(now())
  status      String    @default("PENDING")
  reviewedBy  Int?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([cid])
  @@index([status])
}

model StaffAccessRequest {
  id          Int       @id @default(autoincrement())
  cid         Int
  division    String
  name        String?
  email       String?
  role        String?
  rating      String?
  status      String    @default("PENDING")
  reviewedBy  Int?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([cid])
  @@index([status])
}

model FirEventAccess {
  id        Int      @id @default(autoincrement())
  cid       Int
  scope     String   // 'FIR' | 'DIVISION'
  value     String   // FIR code (e.g. "KZNY") or division name (e.g. "VATUSA")
  createdAt DateTime @default(now())
  createdBy Int?

  @@unique([cid, scope, value])
  @@index([cid])
}

// Per-WF-sector planning workspace. The dep and arr managers each propose
// an ATC route and we surface a validation panel comparing the two. Flow
// type lives here as a proposal — an admin can push it to the live
// WfScheduleRow separately.
model SectorPlan {
  id                 Int       @id @default(autoincrement())
  wf                 String
  fromIcao           String
  toIcao             String
  eventId            Int?
  depRouteSuggestion String?
  arrRouteSuggestion String?
  depSplitRoute      String?   // second route for traffic split (departure proposal)
  depSplitPct        Int?      // percentage on primary route (0-100), remainder on split
  arrSplitRoute      String?   // second route for traffic split (arrival proposal)
  arrSplitPct        Int?      // percentage on primary route (0-100), remainder on split
  /// Optional note shown alongside the split routes - e.g. how Clearance
  /// Delivery decides which one you get. Per side like the routes
  /// themselves; the departure side is the one published.
  depSplitNote       String?
  arrSplitNote       String?
  splitAgreed        Boolean   @default(false)
  depFlowType        String?   // 'NONE' | 'BOOKING_REQUIRED'
  depFlowReason      String?   // reason for flow restriction (e.g. 'STAFFING', 'SINGLE_RUNWAY')
  depFlowRate        Int?      // planes/hr — only meaningful when depFlowType = BOOKING_REQUIRED
  // When pilots may start booking this sector. NULL = straight away;
  // "H24" / "H48" = that many hours before the departure window opens;
  // "AT" = at bookingsOpenAt. Teams and affiliates are auto-assigned
  // regardless - only ordinary pilots wait.
  bookingsOpenMode   String?
  bookingsOpenAt     DateTime?
  // When pilot bookings stop. NULL = never; "H6"/"H12"/"H24" = that many
  // hours before the departure window opens; "AT" = at bookingsCloseAt.
  // Teams, affiliates, controllers and admins are never shut out.
  bookingsCloseMode  String?
  bookingsCloseAt    DateTime?
  arrFlowRequest     String?
  arrFlowReason      String?   // reason for flow request (e.g. 'STAFFING', 'SINGLE_RUNWAY')
  arrFlowRequestedBy Int?
  arrFlowRequestedAt DateTime?
  depUpdatedBy       Int?
  depUpdatedAt       DateTime?
  arrUpdatedBy       Int?
  arrUpdatedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([wf, eventId])
  @@index([wf])
}

// Route issues raised by enroute FIR managers once a route is agreed
// between Dep and Arr. Visible to everyone viewing the sector plan.
model SectorPlanIssue {
  id            Int       @id @default(autoincrement())
  sectorPlanId  Int
  wf            String
  raisedByCid   Int
  raisedByFir   String?
  notes         String
  status        String    @default("OPEN")   // 'OPEN' | 'RESOLVED'
  resolvedByCid Int?
  resolvedAt    DateTime?
  replies       String    @default("[]")     // JSON-encoded array of { cid, name?, fir?, side, notes, createdAt }
  createdAt     DateTime  @default(now())

  @@index([sectorPlanId])
  @@index([wf])
  @@index([status])
}

model MasterToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  cid       Int?
  label     String?
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([token])
  @@index([cid])
}

model UserAdditionalRole {
  id               Int      @id @default(autoincrement())
  cid              Int
  role             String
  teamName         String?
  sinceYear        Int?
  canEditBookings  Boolean  @default(true)
  canManageMembers Boolean  @default(false)
  participating    Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@unique([cid, role])
  @@index([cid])
}

/// Manual CID -> Discord account link, for members whose server nickname
/// doesn't contain their CID so the automatic match can't find them.
model DiscordLink {
  id              Int      @id @default(autoincrement())
  cid             Int      @unique
  discordId       String   @unique
  discordNickname String?
  linkedBy        Int?
  linkedAt        DateTime @default(now())

  @@index([discordId])
}

model WfVisitedAirport {
  id        Int      @id @default(autoincrement())
  icao      String
  year      Int
  eventName String?

  @@unique([icao, year])
  @@index([icao])
}

model AirportSuggestion {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  icao        String
  type        String   @default("visit")
  association String
  reason      String
  contact     String
  notify      Boolean  @default(false)
  cid         Int?
  createdAt   DateTime @default(now())

  @@index([icao])
  @@index([type])
}

model TobtBookingBackup {
  id           Int      @id @default(autoincrement())
  eventId      Int
  slotKey      String
  cid          Int
  callsign     String
  from         String
  to           String
  dateUtc      String
  depTimeUtc   String
  tobtTimeUtc  String?
  originalId   Int
  backedUpAt   DateTime @default(now())

  @@index([eventId])
}

model WfScheduleRow {
  id          Int    @id @default(autoincrement())
  eventId     Int
  sortOrder   Int    @default(0)
  number      String
  from        String
  to          String
  dateUtc     String @default("")
  depTimeUtc  String @default("")
  arrTimeUtc  String @default("")
  blockTime   String @default("")
  flightTime  String @default("")
  atcRoute    String @default("")
  atcRoute2   String @default("")   // secondary route for traffic split
  isWfChallenge Boolean @default(false)
  vatcanEventId String?              // id returned by VATCAN's POST /api/event (e.g. "SCf56")
  // Route alternative: NULL on a normal leg. On an alternative it holds the
  // primary leg's number (e.g. "WF2631"), so WF2631 + WF2631.B are the two
  // options for one leg. The primary keeps its plain number and is labelled
  // ".A" at render time only - nothing keyed on the WF number has to move.
  variantOf     String?
  // Which option of an undecided leg takes auto-assigned team and affiliate
  // bookings, as the option letter ("A" for the primary, "B" for the first
  // alternative). Set on the PRIMARY row only - one decision per leg. NULL
  // means no choice was recorded and both options are booked, as they were
  // before this existed. Only consulted on flow-restricted sectors.
  autoBookVariant String?
  // Affiliates can be allocated separately from teams: "A", "B" or "BOTH".
  // NULL follows autoBookVariant, which then governs teams alone. Primary
  // row only, like autoBookVariant.
  affiliateBookVariant String?
  // How many affiliate aircraft, taken from the bottom of the affiliate
  // Display Order, fly the OTHER option instead. Ignored when affiliates
  // are allocated to both options.
  affiliateOverspill   Int?

  @@unique([eventId, number])
  @@index([eventId])
}

model WfEvent {
  id             Int      @id @default(autoincrement())
  name           String
  year           Int
  sheetUrl       String   @default("")
  mode           String   @default("csv")
  isActive       Boolean  @default(false)
  turnaroundMins Int      @default(45)
  isWorldFlight  Boolean  @default(true)
  flightSuffix   String   @default("")
  flightStartNumber Int   @default(1)
  aircraftType   String   @default("B738")
  costIndex      Int      @default(30)
  startDateUtc   String   @default("")
  startTimeUtc   String   @default("")
  nextSectorAfter String  @default("BLOCK")
  cruiseAltitude Int      @default(0)
  cruiseMode     String   @default("CI")
  createdAt      DateTime @default(now())

  @@unique([year])
}

model WfChallengeScore {
  id        Int      @id @default(autoincrement())
  eventId   Int
  callsign  String
  style     Int
  speed     Int
  height    Int
  createdAt DateTime @default(now())

  @@index([eventId])
}

model PageVisibility {
  key     String  @id
  enabled Boolean @default(true)
  mode    String  @default("visible")
}

// "Email me when bookings open" for a sector that is not bookable yet. One
// per pilot per sector; sentAt is set once the email has gone.
model BookingOpenAlert {
  id           Int       @id @default(autoincrement())
  eventId      Int
  sectorNumber String
  cid          Int
  email        String
  createdAt    DateTime  @default(now())
  sentAt       DateTime?

  @@unique([eventId, sectorNumber, cid])
  @@index([sentAt])
}

// Briefing email to the pilots booked on one sector (Admin > Mailing List >
// Sector Emails). subject/body carry {TAGS} that are filled per recipient
// at send time, so a scheduled email always has the current route and
// restrictions. mode: NOW | H6 | H12 | H24 | H48 (hours before the
// scheduled departure, re-read from the schedule each sweep) | AT (sendAt).
model SectorEmail {
  id           Int       @id @default(autoincrement())
  eventId      Int
  sectorNumber String
  subject      String
  body         String
  // BOOKED = pilots booked on the sector; ALL = every member with an
  // email on file (User.email). Opt-outs for the event are skipped.
  audience     String    @default("BOOKED")
  mode         String
  sendAt       DateTime?
  status       String    @default("SCHEDULED")   // SCHEDULED | SENDING | SENT | FAILED | CANCELLED
  sentAt       DateTime?
  sentCount    Int?
  skipped      Int?      // booked pilots with no email on file
  error        String?
  createdBy    Int
  createdAt    DateTime  @default(now())

  @@index([eventId, status])
}

// "Unsubscribe from sector emails" - remembered for one event only, so a
// pilot hears from us again next year. Keyed on the address the email went to.
model SectorEmailOptOut {
  id        Int      @id @default(autoincrement())
  eventId   Int
  email     String
  createdAt DateTime @default(now())

  @@unique([eventId, email])
}

model MailingListSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  firstName String?
  lastName  String?
  cid       Int?
  createdAt DateTime @default(now())

  @@index([email])
}

model SiteSetting {
  key   String @id
  value String
}

model AdminPermission {
  id        Int      @id @default(autoincrement())
  cid       Int
  page      String   @db.VarChar(50)
  createdAt DateTime @default(now())

  @@unique([cid, page])
  @@index([cid])
}

model NavdataFile {
  name       String   @id
  cycle      String?
  content    Bytes
  uploadedAt DateTime @default(now())
}

model AffiliateApplication {
  id          Int       @id @default(autoincrement())
  teamName    String?
  callsign    String
  simType     String
  cid         Int
  sinceYear   Int?
  hasMembers  Boolean   @default(false)
  // contact is the legacy single free-text field; public applications now
  // capture discord + email separately and both are required on the form.
  contact     String?
  discord     String?
  email       String?
  notes       String?
  heardAbout  String?
  website     String?
  source      String    @default("admin")
  status      String    @default("pending")
  decidedBy   Int?
  decidedAt   DateTime?
  // Admin-written reason for a decline; emailed to the applicant and shown
  // on hover over the Declined chip in the admin queue.
  declineReason String?
  affiliateId Int?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([cid])
}

model AffiliateApplicationPhoto {
  id            Int      @id @default(autoincrement())
  applicationId Int
  filename      String
  mime          String
  data          Bytes
  createdAt     DateTime @default(now())

  @@index([applicationId])
}

model ProfilePhoto {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   Int
  mime       String
  data       Bytes
  updatedAt  DateTime @default(now())

  @@unique([entityType, entityId])
}

model TeamSectorOptOut {
  id             Int      @id @default(autoincrement())
  officialTeamId Int
  sectorNumber   String
  createdAt      DateTime @default(now())

  @@unique([officialTeamId, sectorNumber])
  @@index([officialTeamId])
}

model TeamSectorAssignment {
  id             Int      @id @default(autoincrement())
  officialTeamId Int
  sectorNumber   String
  cid            Int
  updatedAt      DateTime @default(now())

  @@unique([officialTeamId, sectorNumber])
  @@index([officialTeamId])
}

// Roster config: which crew roles are enabled for a team/affiliate
model RosterConfig {
  id              Int      @id @default(autoincrement())
  entityType      String   // 'team' or 'affiliate'
  entityName      String   // teamName (uppercase) or affiliate key
  foEnabled       Boolean  @default(true)
  feEnabled       Boolean  @default(false)
  feLabel         String   @default("Flight Engineer")
  obs1Enabled     Boolean  @default(false)
  obs2Enabled     Boolean  @default(false)
  updatedAt       DateTime @default(now())

  @@unique([entityType, entityName])
}

// Roster assignment: who is assigned to which role on which sector
model RosterAssignment {
  id              Int      @id @default(autoincrement())
  entityType      String   // 'team' or 'affiliate'
  entityName      String   // teamName (uppercase) or affiliate key
  sectorNumber    String
  role            String   // 'captain', 'fo', 'fe', 'obs1', 'obs2'
  cid             Int?
  // A roster seat is either a VATSIM member (cid) or a roster member with
  // no account of their own (teamMemberId). The roster is not tied to slots,
  // so someone with no CID can hold any crew role here.
  teamMemberId    Int?
  updatedAt       DateTime @default(now())

  @@unique([entityType, entityName, sectorNumber, role])
  @@index([entityType, entityName])
}

model AtcRequest {
  id             Int      @id @default(autoincrement())
  eventId        Int?
  sectorNumber   String
  fromIcao       String
  toIcao         String
  positionType   String   // 'aerodrome', 'approach', 'ctr'
  callsign       String   @default("") // single callsign per request
  callsigns      String?  // deprecated — kept for migration
  timeFrom       String?  // UTC HH:MM
  timeTo         String?  // UTC HH:MM
  notes          String?
  sectorFileUrl  String?  // link to sector file or controller pack
  requestedBy    Int      // CID of FIR manager
  status         String   @default("waiting") // 'waiting', 'accepted', 'cancelled'
  acceptedBy     Int?     // CID of WF ATC who accepts
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([eventId])
  @@index([sectorNumber])
}
// One controller covering part of an AtcRequest's window. A request with no
// claim rows is either untouched or fully claimed the old way (status +
// acceptedBy); once anyone part-claims it, these rows are the truth about who
// covers what and the request's own window stays as originally asked for.
model AtcRequestClaim {
  id        Int      @id @default(autoincrement())
  requestId Int
  cid       Int
  timeFrom  String   // UTC HH:MM
  timeTo    String   // UTC HH:MM
  claimedAt DateTime @default(now())

  @@index([requestId])
  @@index([cid])
}


model AtcNotifyPreference {
  id          Int      @id @default(autoincrement())
  cid         Int      @unique
  enabled     Boolean  @default(true)
  allHours    Boolean  @default(true)
  hours       String   @default("111111") // 6 chars for 4hr bands: 00-04, 04-08, 08-12, 12-16, 16-20, 20-24
  allPositions Boolean @default(true)
  aerodrome   Boolean  @default(true)
  approach    Boolean  @default(true)
  ctr         Boolean  @default(true)
  updatedAt   DateTime @default(now())
}

// Private per-user notes on a sector page (/sector/:wf/...), one row per CID
// per sector number. Only ever shown to the CID that wrote it.
model UserSectorNote {
  id        Int      @id @default(autoincrement())
  cid       Int
  sector    String   // WF sector number, e.g. "WF2624"
  note      String
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([cid, sector])
}

// Team roster entry. Carries the nickname for members who have a CID, and is
// the only home for members who do not have a VATSIM account yet.
// UserAdditionalRole remains the WF_TEAM access record: a row here with a cid
// pairs with one there, a row without a cid has no access and cannot log in.
// Attaching a cid later fills it in and grants access at that point.
model TeamMember {
  id          Int      @id @default(autoincrement())
  teamName    String   // uppercase, matches OfficialTeam.teamName
  cid         Int?     // null until they have a VATSIM account
  displayName String?  // shown when there is no cid to resolve a name from
  nickname    String?  // replaces the shown name wherever the member appears
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([teamName])
  @@index([cid])
}
